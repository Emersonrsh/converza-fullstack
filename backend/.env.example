# Servidor
PORT=4000
NODE_ENV=development
# URL do app (CORS)
APP_ORIGIN=http://localhost:5173

# Banco de dados
DATABASE_URL=postgres://converza:converza@localhost:5432/converza

# Redis (filas e tempo real)
REDIS_URL=redis://localhost:6379

# Autenticação
JWT_SECRET=troque-isto-por-um-segredo-forte
JWT_EXPIRES_IN=30d

# WhatsApp Cloud API (Meta)
# Token de verificação que você define no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=converza-verify
# Versão da Graph API (a Meta desliga cada versão ~2 anos depois do lançamento; a v24.0 vale até 18/02/2028)
GRAPH_API_VERSION=v24.0

# Embedded Signup (modelo BSP / Tech Provider) — credenciais do OPERADOR.
# Com isto preenchido, o cliente conecta o WhatsApp dele com um clique.
META_APP_ID=
# A chave secreta também é usada para conferir a assinatura (X-Hub-Signature-256)
# dos webhooks do WhatsApp: eventos falsos são recusados.
META_APP_SECRET=
# ID da configuração de Embedded Signup criada no painel do seu app Meta
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Facebook (menu Facebook): login dos perfis para ler os anúncios — configuração do Facebook Login for Business
# com ads_read + business_management (veja a Parte 7 do DEPLOY.md). Vazio = pede as permissões direto no login.
META_ADS_CONFIG_ID=
# Versão da Marketing API (opcional)
# META_ADS_API_VERSION=v26.0

# IA dos agentes (chave do OPERADOR). Sem ela, os agentes não respondem.
# Recomendado: OpenRouter — uma chave dá acesso a GPT, Gemini e Claude.
#   OPENAI_API_KEY=sk-or-...        (sua chave do OpenRouter)
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Modelo padrão dos agentes novos e dos recursos de IA dos fluxos
# AI_DEFAULT_MODEL=openai/gpt-4o-mini

# Voz dos agentes (ElevenLabs, chave do OPERADOR): clonar vozes (aba Vozes), responder em
# mensagem de voz e transcrever os áudios dos clientes. Clonar voz exige o plano Starter ou acima
# da ElevenLabs. Sem a chave, os agentes respondem só em texto.
ELEVENLABS_API_KEY=
# Voz "Padrão da plataforma" (uma voz pronta da sua conta ElevenLabs) e modelos usados
# ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2
# Quanto o áudio desconta do saldo de tokens da conta
# VOICE_TOKENS_PER_CHAR=2
# TRANSCRIBE_TOKENS_PER_MINUTE=600
# Alternativa: OpenAI direto -> OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Só para testes: desliga a conferência da assinatura dos webhooks do WhatsApp
# WHATSAPP_SKIP_SIGNATURE=true
# Só para testes locais com um simulador da Meta (normalmente fica vazio)
# GRAPH_API_BASE=http://localhost:4998

# Áudios gravados no Chats ao vivo são convertidos para mensagem de voz com o ffmpeg
# (o Docker da API já instala). Só preencha se o ffmpeg estiver em outro caminho:
# FFMPEG_PATH=/usr/bin/ffmpeg

# Endereço público da API. Recomendado: é o que aparece nos links rastreáveis (/t/...) e no
# endereço do servidor MCP. Se vazio, usa o próprio endereço da requisição.
# Ex.: PUBLIC_API_URL=https://converza-api.onrender.com
PUBLIC_API_URL=

# E-mail (convites de equipe e da plataforma, aviso de número desconectado, aviso ao suporte).
# Qualquer SMTP serve (Brevo, Resend, SendGrid, Gmail com senha de app...). Sem SMTP, o app
# mostra o link do convite para você copiar e mandar.
# Atenção: no plano Free do Render a API não consegue sair pelas portas 25, 465 e 587 — use a porta
# 2525 (Brevo e SendGrid aceitam) ou o plano Starter.
SMTP_HOST=
SMTP_PORT=587
# true só para a porta 465 (SSL direto); 587 usa STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente (precisa ser um endereço liberado no seu provedor)
EMAIL_FROM="Converza <no-reply@seudominio.com>"

# Equipe de suporte do Converza: e-mails (separados por vírgula) que podem entrar nas empresas
# que liberarem o "Acesso de suporte" em Configurações. Vazio = ninguém.
SUPPORT_EMAILS=

# Programa de parceiros (banner do dashboard)
PARTNER_PROGRAM_ENABLED=true
PARTNER_COMMISSION_PERCENT=40
# Link para o parceiro falar com você (ex.: https://wa.me/5511999999999) — opcional
PARTNER_CONTACT_URL=

# Cobrança — veja DEPLOY.md, Parte 8. Sem as chaves, os botões de pagar ficam desligados.
# Asaas (Pix e cartão no Brasil). Sem ASAAS_ENV=production, usa o sandbox.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENV=production
# Paddle (exterior). Sem PADDLE_ENV=production, usa o sandbox.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# ID do preço mensal da instância no catálogo da Paddle (pri_...)
PADDLE_PRICE_INSTANCE=
# PADDLE_ENV=production
# Preços (opcionais): mensalidade por instância e 1.000 tokens de IA
# INSTANCE_PRICE_BRL=127
# INSTANCE_PRICE_USD=25
# TOKEN_PRICE_BRL_PER_1000=1
# TOKEN_PRICE_USD_PER_1000=0.2
# Link do botão "Falar com Suporte" (se vazio, usa o PARTNER_CONTACT_URL)
SUPPORT_URL=
# Só para testes com simuladores locais (normalmente fica vazio)
# ASAAS_API_BASE=http://localhost:4996/v3
# PADDLE_API_BASE=http://localhost:4996/paddle
